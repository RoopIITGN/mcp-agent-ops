# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# The endpoint is the BARE HOST. Appending /openai/v1 produces a 404 because
# the SDK adds its own path -- an hour lost to that in the retrieval project.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=
# A chat deployment with function calling. src/check_model.py tells you whether
# yours works and prints the settings to use.
#
# A non-reasoning deployment is preferred, because a pinnable temperature is
# what makes the variance floor measurable and anything smaller than that floor
# reportable as a result rather than as inconclusive. A reasoning deployment
# still runs -- backends.AzureBackend probes the parameter set on its first
# call and adapts -- but it rejects `temperature`, needs a larger token budget
# before it will emit a tool call, and costs more per pass because reasoning
# tokens bill as completion and an agent loop re-reasons at every step.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2024-10-21

# Only read on a reasoning deployment, and the single biggest cost lever there.
# Leave blank unless check_model.py reports that the parameter is accepted, and
# use the value it prints.
AZURE_OPENAI_REASONING_EFFORT=
